global proc convertMocapToRig()
{
    string $chrMain[]=`ls -sl`;
    if (size($chrMain)==0)
    	error "No Character Selected !";
    string $tmpList[]=getNamespace($chrMain[0]);
    if (!`gmatch $tmpList[0] "*:"`)
    	error "No Namespace Founded !";
    string $old[]=`ls "MoCap"`;
    if(!size($old)==0)
    {
        catchQuiet(`delete "MoCap"`);
    }
    string $namespace=$tmpList[0];
    shuaiGoToBuildPose($namespace);
    shuaiCreateMoCap($namespace);
    shuaiApplyMocapData("Root_M","Root_MoCap_M");
    shuaiBakeAnim($namespace);
    string $fbxRn=`referenceQuery -filename -unresolvedName -wcn "Root_M"`;
    file -rr $fbxRn;
}
global proc shuaiGoToBuildPose (string $nameSpace)
{
string $controlSets[];
$controlSets[0]=$nameSpace+"ControlSet";

string $buildPose="buildPose";

string $tempString[],$tempString2[],$buffer[];
string $setAttrCmd,$cmd;


$setAttrCmd=`getAttr ($nameSpace+$buildPose+".udAttr")`;
tokenize $setAttrCmd ";" $tempString;
for ($y=0;$y<size($tempString);$y++)
	{
	$cmd=$tempString[$y];
	if ($cmd=="")
		continue;
	if ($nameSpace!="")
		{
		tokenize $cmd $buffer;
		if (`gmatch $cmd "xform*"`)
			$substituteWordNr=size($buffer)-1;
		else
			$substituteWordNr=1;
		$cmd="";
		for ($z=0;$z<size($buffer);$z++)
			{
			if ($z==$substituteWordNr)
				$cmd+=$nameSpace;
			$cmd+=$buffer[$z]+" ";
			}
		}
	if (catchQuiet (`eval ($cmd)`)) warning ("Failed: "+$cmd+"\n");
	}

//run
string $run,$fitTopNode,$objAttr;
for ($i=0;$i<size($controlSets);$i++)
	{
	if (`gmatch $controlSets[$i] "*ControlSet"`)
		if (`objExists ($nameSpace+"FitSkeleton")`)
			$fitTopNode=$nameSpace+"FitSkeleton";
	if (`gmatch $controlSets[$i] "*FaceControlSet"`)
		$fitTopNode=($nameSpace+"FaceFitSkeleton");
	}

if (`objExists $fitTopNode`)
	if (`attributeExists "run" $fitTopNode`)
		{
		$run=`getAttr ($fitTopNode+".run")`;
		if ($run!="")
			{
			if ($nameSpace=="")
				catch (`eval ($run)`);
			else
				{
				tokenize $run ";" $tempString;
				for ($i=0;$i<size($tempString);$i++)
					{
					tokenize $tempString[$i] $tempString2;
					$objAttr=`substitute "\"" $tempString2[1] ""`;
					$objAttr=`substitute "\"" $objAttr ""`;
					$cmd=$tempString2[0]+" "+$nameSpace+$objAttr+" "+$tempString2[2]+";";
					catch (`eval ($cmd)`);
					}
				}
			}
		}
}
global proc shuaiCreateMoCap (string $namespace)
{
    string $deformJoints[]=`listRelatives -type joint -ad ($namespace+"DeformationSystem")`;
    string $setMenbers[]=`sets -q -no ($namespace+"ControlSet")`;
    string $keyDeformJoints[],$tempString[],$parent[],$names[],$extra[],$parentList[],$tmpList[];
    string $extr,$parentJointName,$jointName;
    for ($a=$i=0;$a<size($deformJoints);$a++)
    	{
    	$tmpList=getNamespace($deformJoints[$a]);
    	$jointName=$tmpList[1];
    	if (`gmatch $jointName "*_50"`)
    		continue;
    	if (`gmatch $jointName "*Slider[0-9]*"`)
    		continue;
    	if (`objExists ($namespace+"FaceAllSet")`)
    		if (`sets -im ($namespace+"FaceAllSet") $deformJoints[$a]`)
    			continue;
    	tokenize $jointName "_" $tempString;
    	$extr=$namespace+"FK"+$tempString[0]+"_"+$tempString[1];//fk控制器
    	if (`gmatch $jointName "*Part[0-9]*"`)
    		continue;
    	$keyDeformJoints[$i]=$deformJoints[$a];
    	$extra[$i]=$extr;
    	$tempString[0]=$keyDeformJoints[$i];
    	for ($y=0;$y<99;$y++)
    		{
    		$tempString=`listRelatives -p $tempString[0]`;
    		$parentList=getNamespace($tempString[0]);
    		$parentJointName=$parentList[1];
    		if (!`gmatch $parentJointName "*Part[0-9]*"`)
    			{
    			tokenize $parentJointName "_" $tempString;
    			$parent[$i]=$tempString[0]+"_MoCap_"+$tempString[1];
    			break;
    			}
    		}
    	tokenize $jointName "_" $tempString;
    	string $name=$tempString[0]+"_MoCap_"+$tempString[1];
    	if (!`stringArrayCount $name $names`)
    		{
    		$names[$i]=$name;
    		$i++;
    		}
    	}
    string $topJoint;
    for ($i=0;$i<size($names);$i++)
    	{
    	select -cl;
    	joint -n $names[$i]; 
    	shuaiAlign $names[$i] $keyDeformJoints[$i] 1 1 1 0;
    	setAttr ($names[$i]+".rotateOrder") (`getAttr ($keyDeformJoints[$i]+".rotateOrder")`);
    	if ($i==size($names)-1)
    		{
    		createNode -n "MoCap" transform;
    		createNode -n "CenterOffset" transform;
    		shuaiAlign "CenterOffset" ($namespace+"RootExtraX_M") 1 0 0 0;
    		parent "MoCap" (`shuaiGetRootGrp($namespace)`);
    		parent "CenterOffset" "MoCap";
    		parent $names[$i] "CenterOffset";
    		parentConstraint -mo $names[$i] ($namespace+"RootX_M");
    		$topJoint=$names[$i];
    		} 
    	if(`gmatch $names[$i] "Wrist_*"`)
        	{
        	    tokenize $names[$i] "_" $tempString;
        	    parentConstraint -mo $names[$i] ($namespace+"IKArm_"+$tempString[2]);
        	}
    	if(`gmatch $names[$i] "Ankle_*"`)
        	{
        	    tokenize $names[$i] "_" $tempString;
        	    parentConstraint -mo $names[$i] ($namespace+"IKLeg_"+$tempString[2]);
        	}  
    	//if (`objExists $extra[$i]`)
    	//	setAttr ($extra[$i]+".rotateOrder") 1;
    	}
    
    for ($i=0;$i<size($names);$i++)
    	{
        	if (`objExists $parent[$i]`)
        	{
        		parent $names[$i] $parent[$i];
        	}
    	}
    for ($i=0;$i<size($names);$i++)
    	{
        	if (size(`listRelatives -p $names[$i]`)==0)
        	{
        		delete $names[$i];
        	}
    	}
    string $NoConstraintFK[]={"FKShoulder_L","FKElbow_L","FKWrist_L","FKShoulder_R","FKElbow_R","FKWrist_R","FKHip_L","FKKnee_L","FKAnkle_L","FKHip_R","FKKnee_R","FKAnkle_R"};
    string $ctrlName[];
    for ($i=0;$i<size($names);$i++)
    	{
    	if ((`objExists $extra[$i]`)&&(`objExists $names[$i]`))
    	    {
    	        $ctrlName=getNamespace($extra[$i]);
    	        if((stringArrayFind($ctrlName[1],0,$NoConstraintFK)==-1)&&(stringArrayFind($extra[$i],0,$setMenbers)!=-1))
    	        {
            		if(catchQuiet(`orientConstraint -mo -weight 1 $names[$i] $extra[$i]`))
            		{
            		    print($names[$i]+" can't constraint "+$extra[$i]+"\n" );
            		}
    	        }
    	    }
    	}
    orientConstraint -mo -weight 1 ($namespace+"IKXShoulder_L") ($namespace+"FKShoulder_L");
    orientConstraint -mo -weight 1 -skip x -skip y ($namespace+"IKXElbow_L") ($namespace+"FKElbow_L");
    orientConstraint -mo -weight 1 ($namespace+"IKXWrist_L") ($namespace+"FKWrist_L");
    
    orientConstraint -mo -weight 1 ($namespace+"IKXShoulder_R") ($namespace+"FKShoulder_R");
    orientConstraint -mo -weight 1 -skip x -skip y ($namespace+"IKXElbow_R") ($namespace+"FKElbow_R") ;
    orientConstraint -mo -weight 1 ($namespace+"IKXWrist_R") ($namespace+"FKWrist_R") ;
    
    orientConstraint -mo -weight 1 ($namespace+"IKXHip_L") ($namespace+"FKHip_L") ;
    orientConstraint -mo -weight 1 -skip x -skip y ($namespace+"IKXKnee_L") ($namespace+"FKKnee_L") ;
    orientConstraint -mo -weight 1 ($namespace+"IKXAnkle_L") ($namespace+"FKAnkle_L") ;
    
    orientConstraint -mo -weight 1 ($namespace+"IKXHip_R") ($namespace+"FKHip_R") ;
    orientConstraint -mo -weight 1 -skip x -skip y ($namespace+"IKXKnee_R") ($namespace+"FKKnee_R") ;
    orientConstraint -mo -weight 1 ($namespace+"IKXAnkle_R") ($namespace+"FKAnkle_R") ;
    //orientConstraint -mo $topJoint "RootExtraX_M";
    shuaiMoCapIKRig($namespace);
}
global proc shuaiMoCapIKRig(string $namespace)
{
    spaceLocator -n "Leg_MoCap_L";
    pointConstraint Hip_MoCap_L Ankle_MoCap_L "Leg_MoCap_L";
    aimConstraint -offset 0 0 0 -weight 1 -aimVector 0 0 1 -upVector 0 1 0 -worldUpType "object" -worldUpObject Hip_MoCap_L Knee_MoCap_L "Leg_MoCap_L";
    parentConstraint -mo -sr "x" -sr "y" -sr "z" "Leg_MoCap_L" ($namespace+"PoleLeg_L");
    
    spaceLocator -n "Leg_MoCap_R";
    pointConstraint Hip_MoCap_R Ankle_MoCap_R "Leg_MoCap_R";
    aimConstraint -offset 0 0 0 -weight 1 -aimVector 0 0 1 -upVector 0 1 0 -worldUpType "object" -worldUpObject Hip_MoCap_R Knee_MoCap_R "Leg_MoCap_R";
    parentConstraint -mo -sr "x" -sr "y" -sr "z" "Leg_MoCap_R" ($namespace+"PoleLeg_R");
    
    spaceLocator -n "Arm_MoCap_L";
    pointConstraint Shoulder_MoCap_L Wrist_MoCap_L "Arm_MoCap_L";
    aimConstraint -offset 0 0 0 -weight 1 -aimVector 0 0 1 -upVector 0 1 0 -worldUpType "object" -worldUpObject Shoulder_MoCap_L Elbow_MoCap_L "Arm_MoCap_L";
    parentConstraint -mo -sr "x" -sr "y" -sr "z" "Arm_MoCap_L" ($namespace+"PoleArm_L");
    
    spaceLocator -n "Arm_MoCap_R";
    pointConstraint Shoulder_MoCap_R Wrist_MoCap_R "Arm_MoCap_R";
    aimConstraint -offset 0 0 0 -weight 1 -aimVector 0 0 1 -upVector 0 1 0 -worldUpType "object" -worldUpObject Shoulder_MoCap_R Elbow_MoCap_R "Arm_MoCap_R";
    parentConstraint -mo -sr "x" -sr "y" -sr "z" "Arm_MoCap_R" ($namespace+"PoleArm_R");
    
    string $splinIKExtras[]=`ls ($namespace+"IKSpine?_M")`;
    parentConstraint -mo Root_MoCap_M $splinIKExtras[0];
    int $ctlSize=`size($splinIKExtras)`;
    for($i=1;$i<$ctlSize;$i++)
    {
        string $midSpineMocap="Spine"+$i+"_MoCap_M";
        if(`objExists $midSpineMocap`)
        {
            pointConstraint -mo $midSpineMocap $splinIKExtras[$i];
        }
        
    }
    parentConstraint -mo Chest_MoCap_M $splinIKExtras[size($splinIKExtras)-1];
    
    //expression -s "IKLeg_R.toe=-Toes_MoCap_R.rz;\nIKLeg_L.toe=-Toes_MoCap_L.rz;";
    
    group -n "MoCapLocators" -p "MoCap" {"Leg_MoCap_L","Leg_MoCap_R","Arm_MoCap_L","Arm_MoCap_R"};
    hide "MoCapLocators";
}
global proc string[] getNamespace(string $obj)
{
    string $array[] = stringToStringArray($obj, ":");
    string $nameWithoutNamespace=$array[size($array)-1];
    stringArrayRemoveAtIndex((size($array)-1), $array);
    string $nameSpace=stringArrayToString($array,":")+":";
    if($nameSpace==":")
    {
        $nameSpace="";
    }
    return {$nameSpace,$nameWithoutNamespace};
}
global proc shuaiAlign (string $object, string $alignToObject, int $translate, int $rotate, int $jointOrient, int $rotateOrder)
{
string $parents[]=`listRelatives -p $object`;
string $orientConstraint[];
float $rotation[];
parent $object $alignToObject;
//Might have generated a Xform
string $generatedXform;
string $tempString[]=`listRelatives -p $object`;
if ($tempString[0]!=$alignToObject)
	$generatedXform=$tempString[0];
if ($translate)
	{
	xform -os -t 0 0 0 $object;
	if ($generatedXform!="")
		xform -os -t 0 0 0 $generatedXform;
	}
if ($rotateOrder)
	setAttr ($object+".rotateOrder") `getAttr ($alignToObject+".rotateOrder")`;
if ($rotate)
	{
	xform -os -ro 0 0 0 $object;
	if ($generatedXform!="")
		xform -os -ro 0 0 0 $generatedXform;
	}
if (`objExists $parents[0]`)
	parent $object $parents[0];
else
	parent -w $object;
if ($jointOrient)
	{
	$orientConstraint=`orientConstraint $alignToObject $object`;
	$rotation=`xform -q -os -ro $object`;
	delete $orientConstraint[0];
	setAttr -type float3 ($object+".jointOrient") $rotation[0] $rotation[1] $rotation[2];
	setAttr -type float3 ($object+".rotate") 0 0 0;
	}
}
global proc string shuaiGetRootGrp(string $namespace)
{
    string $MainCtrl[]=`ls ($namespace+"Main")`;
    if(size($MainCtrl)>1)
    {
        error ("场景里面有不只一个名叫“"+$namespace+"Main"+"”的物体");
    }
    string $Path[]=`listRelatives -f $MainCtrl[0]`;
    string $tempString[];
    tokenize $Path[0] "|" $tempString;
    return $tempString[0];
}
global proc shuaiApplyMocapData(string $fbxRoot,string $chrRoot)
{
    //fbx joints align to chr
    //currentTime 0 ;
    //select -r $fbxRoot;
    //gotoBindPose;
    /*string $tmplist[] = `listConnections -type "dagPose" $fbxRoot`;
    string $bindPoseList[] = stringArrayRemoveDuplicates($tmplist);
    string $b;
    for($b in $bindPoseList)
    {
        string $skinNode[]=`listConnections -type "skinCluster" Root_M`;
        if(size($skinNode)>0)
        {
            catch(`dagPose -r -g $b`);
        }
    }*/
    parentConstraint -weight 1 $fbxRoot $chrRoot;
    
    string $ads[]=`listRelatives -type "joint" -ad $fbxRoot`;
    string $i;
    string $mocapJoint;
    string $tmpString[];
    for($i in $ads)
    {
        tokenize $i "_" $tmpString;
        $mocapJoint=$tmpString[0]+"_MoCap_"+$tmpString[1];
        if(`objExists $mocapJoint`)
        {
            orientConstraint -weight 1 $i $mocapJoint;
        }
    }
}
global proc int[] shuaiGetFrameRange()
{
    string $MoCapHips[]=`ls -type "joint" "Root_M"`;
    string $animCurves[]=`listConnections -type "animCurve" $MoCapHips[0]`;
    string $curve;
    int $FrameRange[]={0,0};
    for($curve in $animCurves)
    {
        float $AllFrame[]=`keyframe -q -absolute -timeChange $curve`;
        if($AllFrame[0]<$FrameRange[0])
        {
            $FrameRange[0]=floor($AllFrame[0]);
        }
        if($AllFrame[(size($AllFrame)-1)]>$FrameRange[1])
        {
            $FrameRange[1]=ceil($AllFrame[(size($AllFrame)-1)]);
        }
    }
    playbackOptions -min $FrameRange[0]  -maxTime $FrameRange[1]  -animationStartTime $FrameRange[0]  -animationEndTime $FrameRange[1];
    return $FrameRange;
}
global proc shuaiBakeAnim(string $namespace)
{    
    int $FrameRange[]=shuaiGetFrameRange();
    string $bakeAttrs[],$ctrls[];
    string $setMenbers[]=`sets -q -no ($namespace+"ControlSet")`;
    string $i;
    for($i in $setMenbers)
    {
        if(size(`listRelatives -s $i`)>0)
        {
            stringArrayInsertAtIndex( 0, $ctrls, $i );
        }
    }
    string $checkAttrs[]={".tx",".ty",".tz",".rx",".ry",".rz"};
    string $attr;
    for($i in $ctrls)
    {
        for($attr in $checkAttrs)
        {
            if(`connectionInfo   -isExactDestination  ($i+$attr)`)
            {
                stringArrayInsertAtIndex( 0, $bakeAttrs, ($i+$attr) );
            }
        }
    }
    bakeResults -simulation true -t ($FrameRange[0]+":"+$FrameRange[1]) -sampleBy 1 -disableImplicitControl true -preserveOutsideKeys true -sparseAnimCurveBake false -removeBakedAttributeFromLayer false -removeBakedAnimFromLayer false -bakeOnOverrideLayer false -minimizeRotation true -controlPoints false -shape false $bakeAttrs;
    delete "MoCap";
    delete -cn $ctrls;
}